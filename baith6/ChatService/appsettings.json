{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Spring": {
    "Application": {
      "Name": "ChatService"
    }
  },
  "Eureka": {
    "Instance": {
      "Port": 4099,
      "HostName": "localhost"
    }
  },
  "AppSettings": {
    "Secret": "REPLACE_WITH_A_RANDOM_SECRET_FROM_ENVIRONMENT",
    "AllowedChatOrigins": [
      "http://localhost:8080",
      "http://host.docker.internal:8080",
      "http://localhost:5081"
    ]
  }
}
